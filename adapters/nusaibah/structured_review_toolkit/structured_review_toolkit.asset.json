{
  "key": "nusaibah.structured_review_toolkit",
  "default": "0.1.0",
  "allowed_surfaces": [
    "v1_asset_execute"
  ],
  "allowed_modes": [
    "balanced"
  ],
  "execution": {
    "allowed_substrates": [
      "local_worker"
    ],
    "default_substrate": "local_worker",
    "timeout_seconds": 60
  },
  "versions": {
    "0.1.0": {
      "state": "active",
      "allow_resume": false,
      "inputs": {
        "variables": {
          "required": true,
          "source": "direct",
          "shape": "object"
        }
      },
      "outputs": {
        "tool_result": {
          "required": true,
          "shape": "object"
        }
      },
      "callable": {
        "enabled": true,
        "result_key": "tool_result",
        "result_shape": "object",
        "max_result_bytes": 262144,
        "timeout_seconds": 30
      }
    }
  }
}
