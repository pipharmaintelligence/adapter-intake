{
  "key": "nusaibah.openfda_application_lookup",
  "default": "0.1.1",
  "allowed_surfaces": [
    "v1_asset_execute"
  ],
  "allowed_modes": [
    "balanced"
  ],
  "execution": {
    "allowed_substrates": [
      "local_worker",
      "ecs"
    ],
    "default_substrate": "local_worker",
    "timeout_seconds": 120
  },
  "versions": {
    "0.1.1": {
      "state": "active",
      "allow_resume": false,
      "inputs": {
        "variables": {
          "required": true,
          "source": "direct",
          "shape": "object"
        },
        "openfda_application_runtime": {
          "required": true,
          "source": "direct",
          "shape": "object",
          "contract": {
            "source": {
              "type": "api",
              "authority": "dlm_core",
              "reference": {
                "service": "openfda_application_runtime",
                "runtime_source_handle": "@openfda",
                "runtime_source_request": {
                  "resolve": "eager",
                  "text_from_variable": {
                    "name": "application_number",
                    "prefix": "application_number:"
                  }
                }
              }
            },
            "schema": {
              "source": "governed"
            },
            "partitioning": {
              "mode": "none",
              "source": "none",
              "dimensions": []
            },
            "access": {
              "mode": "service"
            },
            "execution": {
              "strategy": "single_call",
              "developer_hint": "Resolve the governed Runtime Source for Drugs@FDA application records."
            },
            "explainability": {
              "summary": "Use governed openFDA Drugs@FDA application records.",
              "logic": "The trusted runtime resolves the admitted Runtime Source; the adapter only processes normalized records."
            },
            "capabilities": {
              "preview": {
                "supported": false,
                "default_in_developer_env": false
              }
            }
          }
        }
      },
      "outputs": {
        "application_lookup": {
          "required": true,
          "shape": "object"
        }
      },
      "callable": {
        "enabled": true,
        "result_key": "application_lookup",
        "result_shape": "object",
        "max_result_bytes": 262144,
        "timeout_seconds": 30
      }
    }
  }
}
