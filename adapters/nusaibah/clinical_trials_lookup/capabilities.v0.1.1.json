    "clinical_trials.study_search": {
      "operation": "study_search",
      "runtime_input_roles": [
        "trials_search_runtime",
        "trials_phase3_runtime"
      ],
      "remote_mcp": {
        "tool_name": "clinical_trials_search",
        "description": "Search one bounded ClinicalTrials.gov study page with text, intervention aliases, status, design, dates, sponsor and other filters",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variables": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "study_search"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "General free text/Essie query.term search"
                },
                "condition": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Condition or disease search"
                },
                "intervention": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Intervention, medicine or product term"
                },
                "intervention_terms": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "Literal intervention alias"
                  },
                  "description": "Caller-supplied intervention aliases; may be used alongside intervention, combined with literal Essie OR. Requires runtime query-compiler admission for complex expressions."
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Study title or acronym"
                },
                "outcome": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Outcome measure text"
                },
                "sponsor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Sponsor or collaborator name"
                },
                "lead_sponsor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Lead sponsor name"
                },
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Location name, site, city, or country"
                },
                "study_identifier": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "NCT/organisation/secondary study identifier"
                },
                "patient_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Patient-oriented registry search text; no personal patient data"
                },
                "phase": {
                  "type": "string",
                  "description": "Phase enum code, validated by the registry (e.g. PHASE3); exact code list can evolve.",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,49}$"
                },
                "status": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{0,49}$"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,49}$"
                      }
                    }
                  ]
                },
                "study_type": {
                  "type": "string",
                  "description": "Registry study design type",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,49}$"
                },
                "sponsor_class": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50,
                  "description": "Registry sponsor classification enum"
                },
                "country": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Site country search"
                },
                "updated_from": {
                  "type": "string",
                  "format": "date",
                  "description": "Posted registry update on or after this date"
                },
                "updated_to": {
                  "type": "string",
                  "format": "date",
                  "description": "Posted registry update on or before this date"
                },
                "advanced_filter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600,
                  "description": "Operator-reviewed bounded Essie advanced filter"
                },
                "page_size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50,
                  "default": 10
                },
                "page_token": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "description": "Opaque token returned by the immediately preceding page for the same query. Worker admission for some tokens requires independent proof."
                },
                "sort": {
                  "type": "string",
                  "description": "Registry-supported date or numeric sort field (optional :asc or :desc), up to two fields separated by comma, or @relevance; unknown fields are rejected by the registry.",
                  "maxLength": 120
                },
                "count_total": {
                  "type": "boolean",
                  "default": true
                },
                "view": {
                  "type": "string",
                  "enum": [
                    "summary",
                    "research"
                  ],
                  "description": "summary (bounded registry facts) or research (complete source study including available sections; may exceed output byte budget)"
                },
                "preset": {
                  "type": "string",
                  "enum": [
                    "phase3_interventional"
                  ],
                  "description": "Require approved Core-fixed Phase 3 interventional scope instead of constructing an Essie expression in Python"
                }
              },
              "required": [
                "operation"
              ]
            }
          },
          "required": [
            "variables"
          ]
