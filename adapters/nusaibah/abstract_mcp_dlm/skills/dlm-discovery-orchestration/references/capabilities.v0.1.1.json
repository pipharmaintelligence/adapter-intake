    "dlm.nodes.schema": {
      "operation": "nodes.schema",
      "tool_role": "dlm_nodes_schema",
      "remote_mcp": {
        "tool_name": "dlm_get_node_schema",
        "description": "Inspect an authorized node's schema using the selected lake_id and node_key. Resolve or confirm names with the list tools first. Returns up to 100 fields with names, types and optional nullable flags. Read-only; no document contents.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_request"
          ],
          "properties": {
            "tool_request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation",
                "lake_id",
                "node_key"
              ],
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "nodes.schema"
                  ],
                  "description": "Fixed operation for this public tool."
                },
                "lake_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
                  "description": "Exact lake_id returned by lake discovery and resolved or confirmed in this conversation."
                },
                "node_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
                  "description": "Exact node_key returned by node discovery in this same lake and resolved or confirmed in this conversation."
                }
              }
            }
          }
        },
