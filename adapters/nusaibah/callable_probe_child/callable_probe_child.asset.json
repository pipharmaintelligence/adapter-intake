{
  "key": "nusaibah.callable_probe_child",
  "default": "0.1.0",
  "allowed_surfaces": [
    "v1_asset_execute"
  ],
  "allowed_modes": [
    "balanced"
  ],
  "execution": {
    "allowed_substrates": [
      "local_worker",
      "ecs"
    ],
    "default_substrate": "local_worker",
    "timeout_seconds": 120
  },
  "versions": {
    "0.1.0": {
      "state": "active",
      "allow_resume": false,
      "inputs": {
        "records": {
          "required": true,
          "source": "binding",
          "shape": "object"
        },
        "variables": {
          "required": false,
          "source": "direct",
          "shape": "object"
        }
      },
      "outputs": {
        "probe_result": {
          "required": true,
          "shape": "object"
        }
      },
      "callable": {
        "enabled": true,
        "result_key": "probe_result",
        "result_shape": "object",
        "max_result_bytes": 16384,
        "timeout_seconds": 60
      },
      "agents": {
        "summarizer": {
          "contract_key": "agent.nusaibah.callable_probe_child.summarizer",
          "contract_version": "1.0.0",
          "reference": "agent://contracts/nusaibah-callable-probe-child-summarizer"
        }
      }
    }
  }
}
