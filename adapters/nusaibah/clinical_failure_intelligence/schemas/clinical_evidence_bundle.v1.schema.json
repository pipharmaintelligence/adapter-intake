{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Prepared clinical evidence handoff; source_bundle.py validates source-result semantics and digest","type":"object","additionalProperties":false,"required":["schema_version","bundle_id","subject_id","product_id","event_ids","sources"],"properties":{"schema_version":{"const":"clinical_evidence_bundle.v1"},"bundle_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"subject_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"product_id":{"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},{"type":"null"}]},"event_ids":{"type":"array","items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"maxItems":32,"uniqueItems":true},"sources":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["source_result_id","asset_key","asset_version","output_role","purpose","result","result_digest"],"properties":{"source_result_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"asset_key":{"enum":["nusaibah.clinical_trials_lookup","nusaibah.pubmed_evidence","umls_terminology"]},"asset_version":{"const":"0.1.0"},"output_role":{"enum":["trial_result","literature_result","terminology_result"]},"purpose":{"enum":["case","comparator","mechanism","terminology"]},"result":{"type":"object"},"result_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"execution_ref":{"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},{"type":"null"}]}},"allOf":[{"if":{"properties":{"asset_key":{"const":"nusaibah.clinical_trials_lookup"}}},"then":{"properties":{"output_role":{"const":"trial_result"}}}},{"if":{"properties":{"asset_key":{"const":"nusaibah.pubmed_evidence"}}},"then":{"properties":{"output_role":{"const":"literature_result"}}}},{"if":{"properties":{"asset_key":{"const":"umls_terminology"}}},"then":{"properties":{"output_role":{"const":"terminology_result"}}}}]},"maxItems":24}}}
