{
  "key": "nusaibah.company_review_tools_demo",
  "default": "0.1.0",
  "allowed_surfaces": [
    "v1_asset_execute"
  ],
  "allowed_modes": [
    "balanced"
  ],
  "execution": {
    "allowed_substrates": [
      "local_worker"
    ],
    "default_substrate": "local_worker",
    "timeout_seconds": 60
  },
  "versions": {
    "0.1.0": {
      "state": "active",
      "allow_resume": false,
      "inputs": {
        "variables": {
          "required": true,
          "source": "direct",
          "shape": "object"
        }
      },
      "outputs": {
        "review_preview": {
          "required": true,
          "shape": "object"
        }
      },
      "callable_assets": {
        "review_toolkit": {
          "asset_key": "nusaibah.structured_review_toolkit",
          "asset_version": "0.1.0",
          "result_key": "tool_result",
          "result_shape": "object"
        }
      }
    }
  }
}
