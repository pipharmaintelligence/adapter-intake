{
  "schema_version": "asset_run_profile.v1",
  "adapter": {
    "key": "sfda.getdrugs_daily_changes",
    "version": "0.1.0"
  },
  "mode": "balanced",
  "variables": {
    "latest_extraction_date": "2026-07-16",
    "previous_extraction_date": "2026-07-15"
  },
  "inputs": {
    "latest_snapshot": {
      "mode": "partition_file",
      "source_ref": "@input.latest_snapshot.source",
      "node_ref": "@input.latest_snapshot.node",
      "partition_filters_from_variables": {
        "extraction_date": "latest_extraction_date"
      },
      "materializer": {
        "key": "json_object",
        "format": "json",
        "content_type": "application/json",
        "record_path": "/records",
        "complete_required": true
      },
      "required": true,
      "shape": "object"
    },
    "previous_snapshot": {
      "mode": "partition_file",
      "source_ref": "@input.previous_snapshot.source",
      "node_ref": "@input.previous_snapshot.node",
      "partition_filters_from_variables": {
        "extraction_date": "previous_extraction_date"
      },
      "materializer": {
        "key": "json_object",
        "format": "json",
        "content_type": "application/json",
        "record_path": "/records",
        "complete_required": true
      },
      "required": true,
      "shape": "object"
    }
  },
  "outputs": {
    "data": {
      "mode": "logical",
      "required": true,
      "shape": "object"
    }
  },
  "context": {
    "max_change_rows": 1000
  }
}
