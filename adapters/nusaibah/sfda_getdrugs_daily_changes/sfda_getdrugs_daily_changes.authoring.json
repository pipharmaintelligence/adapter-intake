{
  "schema_version": "asset_authoring_contract.v1",
  "identity": {
    "asset_key": "sfda.getdrugs_daily_changes",
    "asset_version": "0.1.0"
  },
  "runtime": {
    "package": "pi-obs-python-runtime",
    "minimum_version": "0.1.70"
  },
  "inputs": {
    "latest_snapshot": {
      "handle": "@input.latest_snapshot",
      "mode": "partition_file",
      "source": {
        "type": "file",
        "authority": "dlm",
        "source_ref": "@input.latest_snapshot.source",
        "node_ref": "@input.latest_snapshot.node",
        "format_policy": {
          "source": "governed",
          "server_admission_required": true
        }
      },
      "schema": {
        "handle": "@input.latest_snapshot.schema",
        "source": "governed"
      },
      "partitioning": {
        "mode": "partitioned",
        "source": "governed",
        "dimensions": ["extraction_date"],
        "partition_filters_from_variables": {
          "extraction_date": "latest_extraction_date"
        }
      },
      "materializer": {
        "key": "json_object",
        "format": "json",
        "content_type": "application/json",
        "record_path": "/records",
        "complete_required": true
      },
      "execution": {
        "strategy": "batch"
      }
    },
    "previous_snapshot": {
      "handle": "@input.previous_snapshot",
      "mode": "partition_file",
      "source": {
        "type": "file",
        "authority": "dlm",
        "source_ref": "@input.previous_snapshot.source",
        "node_ref": "@input.previous_snapshot.node",
        "format_policy": {
          "source": "governed",
          "server_admission_required": true
        }
      },
      "schema": {
        "handle": "@input.previous_snapshot.schema",
        "source": "governed"
      },
      "partitioning": {
        "mode": "partitioned",
        "source": "governed",
        "dimensions": ["extraction_date"],
        "partition_filters_from_variables": {
          "extraction_date": "previous_extraction_date"
        }
      },
      "materializer": {
        "key": "json_object",
        "format": "json",
        "content_type": "application/json",
        "record_path": "/records",
        "complete_required": true
      },
      "execution": {
        "strategy": "batch"
      }
    }
  },
  "outputs": {
    "data": {
      "handle": "@output.data",
      "mode": "logical",
      "schema": {
        "handle": "@output.data.schema",
        "source": "explicit",
        "fields": [
          {"name": "trace", "type": "object", "required": true},
          {"name": "summary", "type": "object", "required": true},
          {"name": "changes", "type": "array", "required": true}
        ]
      },
      "validation": {
        "self_inspection": {
          "enforce": true,
          "on_fail": "fail"
        }
      }
    }
  }
}
