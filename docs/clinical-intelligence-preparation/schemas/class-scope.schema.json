{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dms-ai:clinical-preparation:class-scope",
  "$comment": "Draft design only. No runtime admission, authority grant, promotion or scientific certification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "clinical_class_scope.draft.v1"
    },
    "pharmacological_class_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "classification_system_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scope_mode": {
      "enum": [
        "all_known_in_snapshot",
        "selected_subset"
      ]
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "eligibility_policy_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "complete": {
          "type": "boolean"
        },
        "eligible_products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "product_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "molecule_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "pharmacological_class_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "product_id",
              "molecule_id",
              "pharmacological_class_id"
            ]
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "product_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "reason_code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "product_id",
              "reason_code"
            ]
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "semantic_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "reason_code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "semantic_ref",
              "reason_code"
            ]
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "source_ref",
        "snapshot_digest",
        "as_of_date",
        "eligibility_policy_ref",
        "complete",
        "eligible_products",
        "excluded",
        "unresolved"
      ]
    },
    "selected_products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "molecule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "pharmacological_class_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "required": [
          "product_id",
          "molecule_id",
          "pharmacological_class_id"
        ]
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "selected_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "product_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "indication_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "trial_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          },
          "regimen_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "required": [
          "case_ref",
          "product_id",
          "indication_ref",
          "trial_refs"
        ]
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "block_overflow_no_pagination"
        },
        "eligible_product_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_product_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_case_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "const": false
        },
        "pagination_applied": {
          "const": false
        }
      },
      "required": [
        "policy",
        "eligible_product_count",
        "selected_product_count",
        "selected_case_count",
        "truncated",
        "pagination_applied"
      ]
    },
    "case_inventory_complete": {
      "enum": [
        true,
        false,
        null
      ]
    },
    "legacy_class_mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pharmacological_class_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "pharmacological_group_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "pharmacological_class_id",
        "pharmacological_group_id",
        "source_ref"
      ]
    },
    "assessment_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_existing": {
          "const": true
        },
        "assess_missing": {
          "const": true
        },
        "include_partial_results": {
          "const": true
        },
        "skill_updates": {
          "const": "preview_only"
        }
      },
      "required": [
        "review_existing",
        "assess_missing",
        "include_partial_results",
        "skill_updates"
      ]
    }
  },
  "required": [
    "schema_version",
    "pharmacological_class_id",
    "classification_system_ref",
    "scope_mode",
    "as_of_date",
    "membership",
    "selected_products",
    "selected_cases",
    "extent",
    "case_inventory_complete",
    "assessment_policy"
  ]
}
